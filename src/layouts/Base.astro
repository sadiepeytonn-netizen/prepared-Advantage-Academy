---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { businessSchema, crumbsSchema } from '../data/schema';

interface Props {
  title: string;
  description: string;
  schema?: object[];
  crumbs?: { name: string; href: string }[];
  noindex?: boolean;
  ogImage?: string;
}
const { title, description, schema = [], crumbs, noindex = false, ogImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const og = ogImage ?? `${site.url}/og-image.jpg`;
const all = [businessSchema(), ...(crumbs ? [crumbsSchema([{ name: 'Home', href: '/' }, ...crumbs])] : []), ...schema];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="google-site-verification" content={site.googleVerification} />
    <meta name="geo.region" content="US-TX" />
    <meta name="geo.placename" content="Longview" />
    <meta name="geo.position" content={`${site.lat};${site.lng}`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="theme-color" content="#1e2428" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Source+Sans+3:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    {all.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
