---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Faqs from '../../components/Faqs.astro';
import ContactForm from '../../components/ContactForm.astro';
import { classes, type ClassInfo } from '../../data/classes';
import { site } from '../../data/site';
import { img } from '../../data/images';
import { courseSchema, faqSchema } from '../../data/schema';

export function getStaticPaths() {
  return classes.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props as { c: ClassInfo };
const photo = img(c.image);
const others = classes.filter((o) => o.slug !== c.slug);
const isLtc = c.slug === 'texas-license-to-carry';
const crumbs = [{ name: 'Classes', href: '/classes/' }, { name: c.short, href: `/classes/${c.slug}/` }];
---
<Base title={c.title} description={c.description} crumbs={crumbs} schema={[courseSchema(c), faqSchema(c.faqs)]} ogImage={photo.src}>
  <PageHead title={c.name} lede={c.summary} crumbs={crumbs}>
    <div class="btn-row" style="margin-top:8px">
      <a class="btn btn--primary" href={site.phoneHref}>Call {site.phone} to enroll</a>
    </div>
  </PageHead>

  <section class="section">
    <div class="wrap class-layout">
      <div>
        <img src={photo.src} alt={photo.alt} width="1200" height="900" style="border-radius:4px;aspect-ratio:16/9;object-fit:cover;width:100%;margin-bottom:32px" />
        {c.body.map((p) => <p>{p}</p>)}

        {isLtc && (
          <ol class="steps">
            <li><div><h3>Schedule your class</h3><p>Call {site.phone} to reserve a seat. Pay at the time of class, by cash or check.</p></div></li>
            <li><div><h3>Apply to Texas DPS</h3><p>Fill out the License to Carry application on the Texas DPS website and pay the state fee, before or after class (we recommend after). Save the payment receipt with the barcode.</p></div></li>
            <li><div><h3>Get fingerprinted</h3><p>We explain this in class. Do not book your fingerprint appointment until after you have submitted your application.</p></div></li>
          </ol>
        )}

        <h2 style="margin-top:48px">What the class covers</h2>
        <ul class="ticks">{c.covers.map((x) => <li>{x}</li>)}</ul>

        <h2 style="margin-top:40px">Questions about this class</h2>
        <Faqs items={c.faqs} />
      </div>
      <aside>
        <dl class="facts">
          {c.price && <div><dt>Price</dt><dd>{c.price}</dd></div>}
          <div><dt>Hours</dt><dd>{c.hours}</dd></div>
          <div><dt>When</dt><dd>{c.when}</dd></div>
          <div><dt>For</dt><dd>{c.who}</dd></div>
          <div><dt>Bring</dt><dd>{c.bring.join('. ')}.</dd></div>
          <div><dt>Where</dt><dd><a href={site.googleMaps} target="_blank" rel="noopener">5914 Old Hwy 80, Longview</a></dd></div>
        </dl>
        <ContactForm heading="Reserve a seat" selected={c.slug} />
      </aside>
    </div>
  </section>

  <section class="section section--concrete">
    <div class="wrap">
      <h2>Other classes</h2>
      <ul class="area-list" style="margin-top:20px">
        {others.map((o) => <li><a href={`/classes/${o.slug}/`}>{o.name}</a></li>)}
      </ul>
    </div>
  </section>
</Base>
